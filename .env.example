# ------------------------------------------------------------------
# CV Attendance System — Environment Template
# Copy to `.env` and adjust before running.
# NEVER commit the real `.env` file (see .gitignore).
# ------------------------------------------------------------------

# --- Server -------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Camera -------------------------------------------------------
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_ENABLED=true
PROCESS_SCALE=0.25

# --- Face Recognition ---------------------------------------------
# Primary engine: InsightFace (SCRFD + ArcFace, 512-d) — PREFER_INSIGHTFACE=true
# Fallback engine: dlib (HOG + ResNet, 128-d)
PREFER_INSIGHTFACE=true
# INSIGHTFACE_DET_SIZE must be square (SCRFD builds anchors from the height axis).
INSIGHTFACE_DET_SIZE=320
TOLERANCE=0.6
QUALITY_THRESHOLD=0.4
AUGMENT_MIN_DISTANCE=0.2
AUGMENT_COOLDOWN_MINUTES=5
MAX_ENCODINGS_PER_PERSON=10

# --- Attendance ---------------------------------------------------
COOLDOWN_SECONDS=8
MIN_WORK_HOURS=1
MAX_WORK_HOURS=16

# --- Database -----------------------------------------------------
DATABASE_URL=sqlite:///data/cv_attendance.db
DB_ECHO=false

# --- Redis (rate limiting & sessions) -----------------------------
REDIS_URL=redis://localhost:6379/0

# --- Security / JWT -----------------------------------------------
# CHANGE THIS before exposing the server on a network (min 32 chars).
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Admin panel (HTTP Basic on /admin and /api/admin/*) ----------
# CHANGE THESE before production use.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Rate limiting ------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# --- Paths --------------------------------------------------------
DATA_DIR=data
DB_PATH=data/db.json
FACES_DIR=data/faces
ATTENDANCE_DIR=data/attendance

# --- Logging / Monitoring -----------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
